# Copy to apps/api/.env and fill real values. Never commit .env. Keys: docs/15-env-setup.md
NODE_ENV=development
APP_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Neon: pooled URL for the app, direct URL for prisma migrate (your own dev branch)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/aptransit?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/aptransit?sslmode=require

# Upstash (TLS)
REDIS_URL=rediss://default:PASSWORD@example.upstash.io:6379

# Auth
JWT_SECRET=replace-with-64-random-characters-000000000000000000000000000000
OTP_PEPPER=replace-with-32-random-characters
OTP_DEV_ECHO=1
# Sign in with Google (D-043). Leave empty to hide Google sign in.
GOOGLE_CLIENT_ID=

# QR signing (generate with the commands in docs/15)
QR_SIGNING_PRIVATE_KEY=base64-of-an-ed25519-pkcs8-pem
QR_SIGNING_KEY_ID=k1
QR_SECRET_KEY=base64-of-32-random-bytes

# Razorpay: test keys only, live keys are refused at boot
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Email
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="AP TransitOS <onboarding@resend.dev>"

# Dev and CI only switches, must be 0 in production
PAYMENTS_FAKE=0

# Worker mode and jobs
WORKER=0
BULLMQ_DRAIN_DELAY_SEC=60
TZ_DISPLAY=Asia/Kolkata
