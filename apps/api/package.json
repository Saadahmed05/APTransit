{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate",
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "WORKER=1 nest start --watch --preserveWatchOutput --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/reset.ts",
    "demo:window": "tsx prisma/demo-window.ts",
    "rollups:backfill": "tsx scripts/backfill-rollups.ts"
  },
  "dependencies": {
    "@aptransit/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "^5.81.5",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "^6.2.12",
    "nestjs-pino": "5.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "razorpay": "^2.9.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@aptransit/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "7.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  }
}
